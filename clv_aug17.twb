      </column>
      <column caption='Debug User Total' datatype='real' name='[Calculation_5207709325001297936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [user_id] : SUM([price_usd])}' />
      </column>
      <column caption='LTV Per User' datatype='real' name='[Calculation_5207709325002018834]' role='measure' type='quantitative'>
