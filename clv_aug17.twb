      <aliases enabled='yes' />
      <column caption='AOV' datatype='real' name='[Calculation_5207709324985184257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price_usd]) / COUNTD([order_id])' />
      </column>
      <column caption='Purchase Frequency Per Year' datatype='real' name='[Calculation_5207709324985327618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id]) / &#10;(DATEDIFF(&apos;year&apos;, MIN([order_date]), MAX([order_date])) + 1)' />
      </column>
      <column caption='Customer Lifespan Days' datatype='integer' name='[Calculation_5207709324985421827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, MIN([order_date]), MAX([order_date])) + 1' />
      </column>
      <column caption='Customer Lifespan Years' datatype='real' name='[Calculation_5207709324985520132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5207709324985421827] / 365.25' />
      </column>
      <column caption='Predicted LTV Simple' datatype='real' name='[Calculation_5207709324985606149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5207709324985184257] * [Calculation_5207709324985327618] * [Calculation_5207709324985520132]) &#10;- MAX([customer_acquisition_cost])' />
      </column>
      <column caption='Registration Month' datatype='datetime' name='[Calculation_5207709324986949639]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [registration_date])' />
      </column>
      <column caption='Order Month' datatype='datetime' name='[Calculation_5207709324987985928]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [order_date])' />
      </column>
      <column caption='Cohort Period' datatype='integer' name='[Calculation_5207709324989054985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_5207709324986949639], [Calculation_5207709324987985928])' />
      </column>
      <column caption='Avg CAC Per User' datatype='real' name='[Calculation_5207709324997255180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_acquisition_cost]) / COUNTD([user_id])' />
      </column>
      <column caption='Simple Average Price' datatype='real' name='[Calculation_5207709325000851470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([price_usd])' />
      </column>
      <column caption='Revenue Per User' datatype='real' name='[Calculation_5207709325000966159]' role='measure' type='quantitative'>
